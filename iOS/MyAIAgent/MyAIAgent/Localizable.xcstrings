        },
        "en-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You're offline. Ask here for instant shop guides — the AI assistant follows up once you're back online."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Pregunta aquí y recibe guías del taller al instante; el asistente de IA responderá cuando vuelvas a estar en línea."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Posez votre question ici pour obtenir les guides de l'atelier — l'assistant IA fera le suivi dès le retour de la connexion."
          }
        }
      }
    },
